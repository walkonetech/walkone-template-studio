{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*",
    "src/export/**/*",
    "src/output/**/*",
    "src/domain/**/*",
    "src/canvas/**/*",
    "src/editor/**/*"
  ],
  "exclude": [
    "src/domain/**/__tests__/**",
    "src/domain/**/*.test.ts",
    "src/export/**/__tests__/**",
    "src/output/**/__tests__/**"
  ]
}
